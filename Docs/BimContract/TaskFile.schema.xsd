<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="taskFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="commandId" type="xs:int" minOccurs="0" />
        <xs:element name="commandText" type="xs:string" />
        <xs:element name="filePath" type="xs:string" />
        <xs:element name="resultFilePath" type="xs:string" />
        <xs:element name="options" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <!-- Зарезервировано для будущих параметров команды. stopOnFirstError убран:
                   обеспечивается остановкой SheetExportService после первой ошибки,
                   частичный успех контрактом ResultFile не допускается. -->
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
