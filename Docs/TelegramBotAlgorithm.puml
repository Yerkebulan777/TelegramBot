@startuml
title TelegramBotServer - overall bot algorithm
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam participantPadding 20
skinparam boxPadding 10
autonumber

actor User
participant "Program" as Program
participant "TelegramBotHostedService" as Hosted
participant "TelegramUpdateMapper" as Mapper
participant "ISessionManager" as Sessions
participant "CommandAppService" as App
participant "SlashCommandService" as Slash
participant "CallbackDispatcher" as Dispatcher
participant "ICallbackHandler\n(chain of responsibility)" as Handler
participant "CommandToggleHandlerBase" as Toggle
participant "IKeyboardBuilder" as Keyboard
participant "ITelegramOutputService" as Output
participant "IDataService" as Data

== Startup ==
Program -> Program: Build host
Program -> Program: Configure services and logging
Program -> Program: InitializeDatabaseAsync()
Program -> Program: SeedAdminUsersAsync()
Program -> Hosted: Start Telegram polling

== Update processing loop ==
loop For each incoming Telegram Update
    User -> Hosted: Message or callback update
    Hosted -> Mapper: Map(Update)
    Mapper --> Hosted: MessageDto / CallbackQueryDto

    alt MessageDto
        Hosted -> Sessions: AcquireUserLockAsync(userId)
        Hosted -> Sessions: GetOrCreateSession(userId)
        Hosted -> App: HandleUserCommandAsync(message)
        App -> Slash: HandleUserCommandAsync(message)

        alt /start or /help (bypasses access check)
            Slash -> Slash: Register user or show help
            Slash -> Output: Send help message
        else /export
            Slash -> Keyboard: GetCommandsKeyboardAsync(session, isExport=true)
            Slash -> Output: Send message with export command keyboard
        else /automation
            Slash -> Keyboard: GetCommandsKeyboardAsync(session, isExport=false)
            Slash -> Output: Send message with automation keyboard
        else /status
            Slash -> Data: GetSessionsListAsync(userId)
            Slash -> Keyboard: GetSessionsListKeyboardAsync(statusList)
            Slash -> Output: Send status message with keyboard
        else Reply keyboard action (Apply / Confirm / Back / Cancel)
            Slash -> Slash: Handle reply action
            Slash -> Output: Send/edit reply keyboard
        else Unknown / non-command text
            Slash -> Slash: Ignore or log warning
        end

    else CallbackQueryDto
        Hosted -> Sessions: AcquireUserLockAsync(userId)
        Hosted -> Sessions: GetOrCreateSession(userId)
        Hosted -> App: HandleCallbackAsync(callback)
        App -> Dispatcher: DispatchAsync(context)

        loop Handlers ordered by Priority (0, 10, 20, 100)
            Dispatcher -> Handler: CanHandle(prefix)
            alt Handler supports prefix
                Handler -> Handler: HandleAsync(context)
                alt CommandToggleHandlerBase (ExportCommand / AutomationCommand)
                    Toggle -> Toggle: HandleAsyncInternal(context)
                    Toggle -> Toggle: Toggle pending command in session
                    Toggle -> Keyboard: GetCommandsKeyboardAsync(session, isExport)
                    Keyboard --> Toggle: InlineKeyboardMarkup
                    Toggle -> Output: EditMessageReplyMarkupAsync(userId, messageId, keyboard)
                else AccessRequestHandler
                    Handler -> Data: UpsertUser / UpdateStatus
                    Handler -> Output: Notify admin or user
                else FileNavigationHandler
                    Handler -> FileSystemBrowser: Resolve path
                    Handler -> Output: Send navigation keyboard
                else FileSelectionHandler
                    Handler -> Sessions: ToggleSelectedFile(file)
                    Handler -> Keyboard: GetFileSelectionKeyboardAsync(session)
                    Handler -> Output: EditMessageReplyMarkupAsync(keyboard)
                else CommandSelectionHandler
                    Handler -> Sessions: AddPendingCommand / Reset
                    alt APPLYCOMMANDS
                        Handler -> Keyboard: GetProjectSelectionKeyboardAsync()
                    else CANCELCOMMANDSSEL
                        Handler -> Sessions: ResetNavigation / Clear commands
                    end
                    Handler -> Output: Send new keyboard
                else SessionManagementHandler
                    alt SESSIONDETAILS
                        Handler -> Sessions: SetStatusView / SetCommandsView
                    else DELETESESSION / DELETECOMMAND
                        Handler -> Data: Soft-delete session or command
                    else BACKTOSTATUS
                        Handler -> Sessions: ResetStatusView
                    end
                    Handler -> Keyboard: Build session keyboard
                    Handler -> Output: EditMessageReplyMarkupAsync(keyboard)
                end
                Dispatcher --> App: handled = true
                break
            else Not supported
                Dispatcher -> Dispatcher: Continue search
            end
        end

        Hosted -> Output: AnswerCallbackQuery(callbackQueryId)
    end
end

note over Hosted,App
  Main idea:
  1) long-polling, no webhooks
  2) update mapped to DTO; session lock prevents concurrent user actions
  3) messages handled by SlashCommandService (commands) or reply actions
  4) callbacks dispatched by CallbackDispatcher via Chain of Responsibility
  5) command toggle handlers update session state and rebuild keyboards
  6) all data persisted via Dapper + SQLite (soft-delete only)
end note

@enduml
