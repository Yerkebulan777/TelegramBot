```gitignore
# Build artifacts
bin/
obj/
*.dll
*.exe
*.pdb
*.so
*.dylib
*.jar
*.war
*.class

# Dependencies
packages/
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Test and coverage
coverage/
htmlcov/
.coverage
*.tmp

# Distribution / packaging
dist/
build/
target/
.npm
.yarn

# Cache directories
__pycache__/
*.pyc
*.pyo
.Python
```