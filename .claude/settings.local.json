      "Bash(find TelegramBotServer -maxdepth 3 -name \"*.cs\" -type f ! -path \"*/obj/*\" -exec wc -l {} + | sort -rn)",
      "Bash(cd \"C:/Users/y.zhumabayev/Yandex.Disk/Repository/TelegramBot\" && dotnet build TelegramBotServer/TelegramBotServer.csproj 2>&1 | tail -20)",
      "Bash(cd \"C:/Users/y.zhumabayev/Yandex.Disk/Repository/TelegramBot\" && dotnet build TelegramBotServer/TelegramBotServer.csproj 2>&1)",
      "Bash(winget upgrade:*)",
