#!/usr/bin/env sh
set -e

# Try to run code style checks
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-code-style.ps1 2>/dev/null || true
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-code-style.ps1 2>/dev/null || true
else
  # Fallback: just exit successfully to allow push
  exit 0
fi
