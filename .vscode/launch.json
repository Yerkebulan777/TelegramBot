{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TelegramBotServer (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/TelegramBotServer/bin/Debug/net8.0/TelegramBotServer.dll",
            "args": [],
            "cwd": "${workspaceFolder}/TelegramBotServer",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
