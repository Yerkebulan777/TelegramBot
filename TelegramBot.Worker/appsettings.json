{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "DialogDismisser": {
    "Enabled": false,
    "MaxDismissAttempts": 10,
    "KnownDialogPatterns": [
      "Error",
      "Warning",
      "Information",
      "Ошибка",
      "Предупреждение",
      "Внимание"
    ],
    "CloseButtonTexts": [
      "OK", "ОК", "Принять", "Accept", "Закрыть", "Close",
      "Игнорировать", "Ignore", "Отмена", "Cancel", "Нет", "No",
      "Да", "Yes", "Продолжить", "Continue",
      "Не сохранять", "Don't Save", "Сохранить", "Save"
    ],
    "ExclusionDialogTitles": [
      "Информация", "Information", "Справка", "Help"
    ]
  },
  "FileSystem": {
    "LogDirectory": null,
    "TaskDirectory": null
  },
  "BimIntegration": {
    "MinSupportedVersion": 2018,
    "MaxSupportedVersion": 2026,
    "RevitInstallRoot": "C:\\Program Files\\Autodesk"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=telegram_bot;Username=postgres;Password=postgres;Timeout=30;Minimum Pool Size=2;Connection Idle Lifetime=300"
  },
  "Worker": {
    "ProcessTimeoutMinutes": 180,
    "FallbackPollingIntervalSeconds": 300,
    "CleanupIntervalSeconds": 300,
    "ProcessMonitorIntervalSeconds": 30,
    "CompletedSessionRetentionDays": 30,
    "MaxConcurrentCommands": 5,
    "Commands": {
      "PDF": {
        "ExecutablePath": "Revit.exe",
        "ArgumentsTemplate": "/command \"WORKER\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".rfa"]
      },
      "DWG": {
        "ExecutablePath": "Revit.exe",
        "ArgumentsTemplate": "/command \"WORKER\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".rfa"]
      },
      "IFC": {
        "ExecutablePath": "Revit.exe",
        "ArgumentsTemplate": "/command \"WORKER\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".rfa"]
      },
      "BIMDOC": {
        "ExecutablePath": "Revit.exe",
        "ArgumentsTemplate": "/command \"WORKER\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".rfa"]
      },
      "NWC": {
        "ExecutablePath": "Revit.exe",
        "ArgumentsTemplate": "/command \"WORKER\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".rfa"]
      },
      "CLASHREP": {
        "ExecutablePath": "FileConvert.exe",
        "ArgumentsTemplate": "/command \"{CommandText}\" \"{TaskFilePath}\"",
        "AllowedExtensions": [".nwc", ".nwd", ".nwf"]
      },
      "AUTORES": {
        "ExecutablePath": "python",
        "ArgumentsTemplate": "ai_agent.py --command \"{CommandText}\" --task \"{TaskFilePath}\"",
        "AllowedExtensions": [".rvt", ".ifc", ".nwc"],
        "WorkingDirectory": "."
      }
    }
  }
}
