<?xml version="1.0" encoding="utf-8"?>
<!-- Копия Docs/TaskFile.schema.xsd — embedded resource для runtime-валидации task-файла
     в CommandPreparer.CreateTaskFile. При изменении контракта обновлять синхронно:
     Docs/TaskFile.schema.xsd, этот файл, TelegramBot.Core/Models/TaskFile.cs,
     эталон RevitBIMFusion/Docs/TaskFile.schema.xsd. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="taskFile">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="commandId" type="xs:int" minOccurs="0" />
        <xs:element name="commandText" type="xs:string" />
        <xs:element name="filePath" type="xs:string" />
        <xs:element name="resultFilePath" type="xs:string" />
        <xs:element name="options" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="continueOnError" type="xs:boolean" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
