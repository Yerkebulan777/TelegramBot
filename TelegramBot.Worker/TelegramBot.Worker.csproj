<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TelegramBot.Worker</RootNamespace>
    <OutputType>WinExe</OutputType>
    <BimContractDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Docs\BimContract'))</BimContractDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelegramBot.Core\TelegramBot.Core.csproj" />
    <ProjectReference Include="..\TelegramBot.Data\TelegramBot.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(BimContractDirectory)\TaskFile.schema.xsd"
                      LogicalName="TelegramBot.Worker.Schemas.TaskFile.schema.xsd" />
  </ItemGroup>

</Project>
