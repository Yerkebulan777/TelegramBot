<Project>

  <!-- Not part of TelegramBot.slnx — keeps `dotnet build TelegramBot.slnx` free of ISCC.
       Run explicitly: dotnet build Installer\Installer.build.proj -t:Installer -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <IsccExe Condition="'$(IsccExe)' == ''">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</IsccExe>
    <SignToolExe Condition="'$(SignToolExe)' == ''">signtool.exe</SignToolExe>
    <TimestampUrl Condition="'$(TimestampUrl)' == ''">http://timestamp.digicert.com</TimestampUrl>
    <!-- Signing is opt-in, two ways to identify the cert (mutually exclusive):
         local dev — /p:SignThumbprint=<thumbprint>          (cert already in Cert:\CurrentUser\My)
         CI        — /p:SignPfxPath=<path> /p:SignPfxPassword=<password>  (portable .pfx, e.g. from a secret)
         Neither set → build is unsigned, same as before. -->
    <SignCertArgs Condition="'$(SignPfxPath)' != ''">/f &quot;$(SignPfxPath)&quot; /p $(SignPfxPassword)</SignCertArgs>
    <SignCertArgs Condition="'$(SignCertArgs)' == '' AND '$(SignThumbprint)' != ''">/sha1 $(SignThumbprint)</SignCertArgs>
    <SignCommand Condition="'$(SignCertArgs)' != ''">&quot;$(SignToolExe)&quot; sign $(SignCertArgs) /fd SHA256 /tr $(TimestampUrl) /td SHA256</SignCommand>
  </PropertyGroup>

  <Target Name="Installer">
    <Error Condition="!Exists('$(IsccExe)')" Text="ISCC.exe not found at '$(IsccExe)'. Install Inno Setup 6, or pass /p:IsccExe=&lt;path&gt;." />
    <Exec Command="dotnet publish &quot;$(RepoRoot)TelegramBot.Server\TelegramBot.Server.csproj&quot; -c Release -o &quot;$(MSBuildThisFileDirectory)publish\Server&quot;" />
    <Exec Command="dotnet publish &quot;$(RepoRoot)TelegramBot.Worker\TelegramBot.Worker.csproj&quot; -c Release -o &quot;$(MSBuildThisFileDirectory)publish\Worker&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)GrantLogonRight\GrantLogonRight.csproj&quot; -c Release -o &quot;$(MSBuildThisFileDirectory)publish\GrantLogonRight&quot;" />

    <Exec Condition="'$(SignCommand)' != ''" Command="$(SignCommand) &quot;$(MSBuildThisFileDirectory)publish\Server\TelegramBot.Server.exe&quot; &quot;$(MSBuildThisFileDirectory)publish\Worker\TelegramBot.Worker.exe&quot; &quot;$(MSBuildThisFileDirectory)publish\GrantLogonRight\GrantLogonRight.exe&quot;" />

    <Exec Command="&quot;$(IsccExe)&quot; &quot;$(MSBuildThisFileDirectory)TelegramBot.iss&quot;" />

    <Exec Condition="'$(SignCommand)' != ''" Command="$(SignCommand) &quot;$(MSBuildThisFileDirectory)Output\TelegramBotSetup.exe&quot;" />
  </Target>

</Project>
